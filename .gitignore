# ═══ feicui（印谱解析工具）根 .gitignore ═══
# 入库范围 A：只公开「人写的代码 + 文档」。
# 本文件合并了 server/.gitignore 与 web/.gitignore 的已有规则（见文末各段），
# 并追加 Zang 与 Kevin 已认可的统一排除口径。

# ── 虚拟环境（本机可重建，不入库）──
venv/
server/.venv/
.venv/

# ── Node / 前端构建 ──
node_modules/
web/node_modules/
dist/
web/dist/

# ── Python 编译产物 ──
__pycache__/
*.pyc

# ── 运行时产物 ──
server/.run/
nohup.out
tmp.pdf
var/
# 拖曳上传落点（`POST /api/jobs/upload` ⇒ `<yyyymmdd>/<原文件名>.pdf`）：用户源 PDF
# （实测 38 MB、历史 372 MB）属**运行时数据**，与 var/ 同档 ⇒ 不入库。
inbox/
# 服务端自测的 fixture（每次跑由脚本用 pymupdf 重造，逐字节不稳定 ⇒ 不入库）
ops/job-upload/fixtures/
# inbox 清理策略（R41）的运行时报告：每次 plan/run（含 API 启动扫描）落一份带时间戳的 JSON
# ⇒ 属运行时产物（与 var/ 同档），不入库。
ops/job-upload/inbox_gc_*.json

# ── 数据 / 导出 / 评测 / 标注产物 ──
output/
exports/
qa-baseline/
qa-recheck/
labeling/
spike-ocr/

# ── 顶层数据 JSON（OCR / 恢复报告）──
/f2_report.json
/f2_ocr_sample_report.json
/f2_recover_report.json
/f2_rerun_report.json
/f2_stamps_before.json
/f2_stamps_after.json

# ── 「斐萃」本地电脑版（webui/，Streamlit；2026-10-16 并入本仓）──
# 敏感 / 机器本地件（**不得入库**）：
#   .env          真实凭据（百度网盘企业版 token、腾讯文档 secret）+ 用户机器上的 FEICUI_ROOT
#   .session.json 登录态（用户名 + 7 天有效期 + 用户目录绝对路径）
#   .agents/ .claude/  豆包 agent 的私有 skill 配置（非产品代码；实盘为空目录，规则为将来兜底）
#   var/          ← 已被上方 `var/` 规则覆盖（tab1 元数据侧车 webui/var/pdf_meta.json 落此）
#   __pycache__/  ← 已被上方规则覆盖
# 入库件：webui/src/*.py、webui/index.html、webui/main.py、webui/requirements.txt、
#         webui/.env.example（占位模板，无真实凭据）、webui/assets/**（logo、占位 tiff）
webui/.env
webui/.session.json
# yinyuan 专用密钥 / 数据缓存：正常落 `~/Library/Application Support/斐萃/`（包外）；
# 万一有人把 FEICUI_DATA_DIR 指进仓内，也必须**不入库**（含明文 key）
webui/yinyuan.json
webui/cache/
webui/.agents/
webui/.claude/
# PyInstaller 打包产物（webui/build/ 下；本单未打包，先占位规则。`dist/` 已被上方通用规则覆盖）
webui/build/build/
webui/build/*.app/
webui/build/.venv-build/
webui/build/build-s*.log

# ── 杂项 ──
.DS_Store
*.local
.evidence-tmp

# ── 原 server/.gitignore 规则（路径改写为仓根视角；glob 收紧为递归，
#    否则嵌套的 selftest/evidence/*/db/*.db 会漏网 —— 见报告）──
server/selftest/evidence/**/*.db
server/selftest/evidence/**/*.db-wal
server/selftest/evidence/**/*.db-shm
server/selftest/evidence/**/*.log
server/selftest/evidence/*.db
server/selftest/evidence/*.db-wal
server/selftest/evidence/*.db-shm
server/selftest/evidence/*.log
