{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    { "src": "^/$", "dest": "/landing/index.html" },
    { "src": "^/index\\.html$", "dest": "/landing/index.html" },
    { "handle": "filesystem" },
    { "src": "^/feicui/assets/(.*)$", "dest": "/assets/$1" },
    { "src": "^/feicui/?$", "dest": "/index.html" },
    { "src": "^/feicui/(.*)$", "dest": "/index.html" }
  ]
}
