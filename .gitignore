# ═══ feicui（印谱解析工具）根 .gitignore ═══
# 入库范围 A：只公开「人写的代码 + 文档」。
# 本文件合并了 server/.gitignore 与 web/.gitignore 的已有规则（见文末各段），
# 并追加 Zang 与 Kevin 已认可的统一排除口径。

# ── 虚拟环境（本机可重建，不入库）──
venv/
server/.venv/
.venv/

# ── Node / 前端构建 ──
node_modules/
web/node_modules/
dist/
web/dist/
# 站内直链下载包：`web/scripts/fetch-downloads.mjs` 在 build 前从 latest Release 拉到
# `web/public/downloads/`（feicui-mac-s1.dmg / feicui-win-s1.zip，单件 ≈ 94 MB）。
# 体积远超 Git 适合的范围 ⇒ 只进 Release 与构建产物，**不入库**。
web/public/downloads/

# ── Python 编译产物 ──
__pycache__/
*.pyc

# ── 运行时产物 ──
server/.run/
nohup.out
tmp.pdf
var/
# 拖曳上传落点（`POST /api/jobs/upload` ⇒ `<yyyymmdd>/<原文件名>.pdf`）：用户源 PDF
# （实测 38 MB、历史 372 MB）属**运行时数据**，与 var/ 同档 ⇒ 不入库。
inbox/
# 服务端自测的 fixture（每次跑由脚本用 pymupdf 重造，逐字节不稳定 ⇒ 不入库）
ops/job-upload/fixtures/
# inbox 清理策略（R41）的运行时报告：每次 plan/run（含 API 启动扫描）落一份带时间戳的 JSON
# ⇒ 属运行时产物（与 var/ 同档），不入库。
ops/job-upload/inbox_gc_*.json

# ── 数据 / 导出 / 评测 / 标注产物 ──
output/
exports/
qa-baseline/
qa-recheck/
labeling/
spike-ocr/

# ── 顶层数据 JSON（OCR / 恢复报告）──
/f2_report.json
/f2_ocr_sample_report.json
/f2_recover_report.json
/f2_rerun_report.json
/f2_stamps_before.json
/f2_stamps_after.json

# ── 「斐萃」本地封装分发版（local-dist/，PyWebView；2026-10-16 并入本仓时名 webui/，
#    2026-10-19 git mv 更名 local-dist/）──
# 敏感 / 机器本地件（**不得入库**）：
#   .env          真实凭据（百度网盘企业版 token、腾讯文档 secret）+ 用户机器上的 FEICUI_ROOT
#   .session.json 登录态（用户名 + 7 天有效期 + 用户目录绝对路径）
#   .agents/ .claude/  豆包 agent 的私有 skill 配置（非产品代码；实盘为空目录，规则为将来兜底）
#   var/          ← 已被上方 `var/` 规则覆盖（tab1 元数据侧车 local-dist/var/pdf_meta.json 落此）
#   __pycache__/  ← 已被上方规则覆盖
# 入库件：local-dist/src/*.py、local-dist/ui/index.html、local-dist/app.py、local-dist/api.py、
#         local-dist/main.py（退役件）、local-dist/requirements.txt、
#         local-dist/.env.example（占位模板，无真实凭据）、local-dist/assets/**（logo、占位 tiff）
local-dist/.env
local-dist/.session.json
# yinyuan 专用密钥 / 数据缓存：正常落 `~/Library/Application Support/斐萃/`（包外）；
# 万一有人把 FEICUI_DATA_DIR 指进仓内，也必须**不入库**（含明文 key）
local-dist/yinyuan.json
local-dist/cache/
local-dist/.agents/
local-dist/.claude/
# PyInstaller 打包产物（local-dist/build/ 下；占位规则。`dist/` 已被上方通用规则覆盖）
local-dist/build/build/
local-dist/build/*.app/
local-dist/build/.venv-build/
local-dist/build/build-s*.log

# ── local-private/datasrc：数据源工作面（feicui-local-private，v1.42）──
# cookies / 抓取产出绝不入库；out/ 只留 .gitkeep 占位（NDJSON 小件是否入库后续再议）
local-private/datasrc/*/cookies.txt
local-private/datasrc/*/out/*
!local-private/datasrc/*/out/.gitkeep

# ── 杂项 ──
.DS_Store
*.local
.evidence-tmp

# ── 原 server/.gitignore 规则（路径改写为仓根视角；glob 收紧为递归，
#    否则嵌套的 selftest/evidence/*/db/*.db 会漏网 —— 见报告）──
server/selftest/evidence/**/*.db
server/selftest/evidence/**/*.db-wal
server/selftest/evidence/**/*.db-shm
server/selftest/evidence/**/*.log
server/selftest/evidence/*.db
server/selftest/evidence/*.db-wal
server/selftest/evidence/*.db-shm
server/selftest/evidence/*.log
